filter(gdpPercap < 50000) %>%
ggplot(aes(x=gdpPercap, y=lifeExp, col=continent, size = country))+
geom_point(alpha=0.5)
gapminder %>%
filter(gdpPercap < 50000) %>%
ggplot(aes(x=gdpPercap, y=lifeExp, col=continent, size = population))+
geom_point(alpha=0.5)
gapminder %>%
filter(gdpPercap < 50000) %>%
ggplot(aes(x=gdpPercap, y=lifeExp, col=continent, size = population))+
geom_point(alpha=0.5)
gapminder %>%
filter(gdpPercap < 50000) %>%
ggplot(aes(x=gdpPercap, y=lifeExp, col=continent, size = pop))+
geom_point(alpha=0.5)
gapminder %>%
filter(gdpPercap < 50000) %>%
ggplot(aes(x=log(gdpPercap), y=lifeExp, col=continent, size = pop))+
geom_point(alpha=0.5)
geom_smooth(method=lm)
gapminder %>%
filter(gdpPercap < 50000) %>%
ggplot(aes(x=log(gdpPercap), y=lifeExp, col=continent, size = pop))+
geom_point(alpha=0.5)
geom_smooth(method=lm)
geom_smooth()
gapminder %>%
filter(gdpPercap < 50000) %>%
ggplot(aes(x=log(gdpPercap), y=lifeExp, col=continent, size = pop))+
